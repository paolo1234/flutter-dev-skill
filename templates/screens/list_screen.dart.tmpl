/// Template per schermata lista con tutti gli stati gestiti.
/// Personalizza: provider, modello, skeleton, empty state, item widget.
///
/// Complessità R29: ~10 punti (lista 3 + pull-to-refresh incluso + app bar)
class __FEATURE_NAME__ListPage extends ConsumerWidget {
  const __FEATURE_NAME__ListPage({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final asyncItems = ref.watch(__itemsProvider__);

    return Scaffold(
      appBar: AppBar(
        title: const Text('__TITLE__'),
        actions: [
          IconButton(
            icon: const Icon(Icons.search),
            tooltip: 'Cerca',
            onPressed: () {
              // TODO: Navigate to search or show search delegate
            },
          ),
        ],
      ),
      body: SafeArea(
        child: asyncItems.when(
          loading: () => const __FEATURE_NAME__ListSkeleton(),
          error: (error, _) => _ErrorState(
            message: _mapErrorMessage(error),
            onRetry: () => ref.invalidate(__itemsProvider__),
          ),
          data: (items) {
            if (items.isEmpty) {
              return const _EmptyState();
            }
            return RefreshIndicator(
              onRefresh: () async {
                ref.invalidate(__itemsProvider__);
                await ref.read(__itemsProvider__.future);
              },
              child: ListView.builder(
                padding: const EdgeInsets.symmetric(vertical: 8),
                itemCount: items.length,
                itemBuilder: (context, index) {
                  final item = items[index];
                  return _ItemTile(
                    item: item,
                    onTap: () {
                      // context.push('/detail/${item.id}');
                    },
                  );
                },
              ),
            );
          },
        ),
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () {
          // context.push('/create');
        },
        tooltip: 'Aggiungi',
        child: const Icon(Icons.add),
      ),
    );
  }

  String _mapErrorMessage(Object error) {
    // Map AppException types to user-friendly messages
    return 'Si è verificato un errore. Riprova.';
  }
}

// --- SKELETON LOADER ---

class __FEATURE_NAME__ListSkeleton extends StatelessWidget {
  const __FEATURE_NAME__ListSkeleton({super.key});

  @override
  Widget build(BuildContext context) {
    return ListView.builder(
      physics: const NeverScrollableScrollPhysics(),
      padding: const EdgeInsets.symmetric(vertical: 8),
      itemCount: 6,
      itemBuilder: (_, __) => const _SkeletonItem(),
    );
  }
}

