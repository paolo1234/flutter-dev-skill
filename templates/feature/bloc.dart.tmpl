/// Cubit managing the state of {{FeatureName}}.
class {{FeatureName}}Cubit extends Cubit<{{FeatureName}}State> {
  {{FeatureName}}Cubit({required this.repository}) : super(const {{FeatureName}}State.initial());

  final {{FeatureName}}Repository repository;

  /// Loads the list of items.
  Future<void> load() async {
    emit(const {{FeatureName}}State.loading());
    try {
      final items = await repository.fetchAll();
      emit({{FeatureName}}State.loaded(items: items));
    } on AppException catch (e) {
      emit({{FeatureName}}State.error(message: e.message));
    } catch (e) {
      emit({{FeatureName}}State.error(message: e.toString()));
    }
  }

  /// Creates a new item.
  Future<void> create(Map<String, dynamic> data) async {
    // Optional: save current state to restore on error
    final currentItems = state.maybeMap(
      loaded: (s) => s.items,
      orElse: () => <{{FeatureName}}Model>[],
    );

    emit(const {{FeatureName}}State.loading());
    try {
      final newItem = await repository.create(data);
      emit({{FeatureName}}State.loaded(items: [...currentItems, newItem]));
    } on AppException catch (e) {
      emit({{FeatureName}}State.loaded(items: currentItems)); // Restore
      emit({{FeatureName}}State.error(message: e.message)); // Could use a specific error event/state here
    }
  }

  /// Deletes an item by [id].
  Future<void> delete(String id) async {
    final currentItems = state.maybeMap(
      loaded: (s) => s.items,
      orElse: () => <{{FeatureName}}Model>[],
    );

    // Optimistic update
    emit({{FeatureName}}State.loaded(
      items: currentItems.where((i) => i.id != id).toList(),
    ));

    try {
      await repository.delete(id);
    } on AppException catch (e) {
      // Rollback on failure
      emit({{FeatureName}}State.loaded(items: currentItems));
      emit({{FeatureName}}State.error(message: e.message));
    }
  }
}

