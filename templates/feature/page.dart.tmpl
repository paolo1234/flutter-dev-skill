/// {{FEATURE_NAME}} page — displays a list of {{FEATURE_NAME}} items.
///
/// Handles all UI states: loading, error, empty, data.
/// Uses pull-to-refresh for data refresh.
// RIVERPOD:
class {{FeatureName}}Page extends ConsumerWidget {
  const {{FeatureName}}Page({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final state = ref.watch({{featureName}}Provider);

    return Scaffold(
      appBar: AppBar(
        title: const Text('{{Feature Name}}'),
        actions: [
          IconButton(
            icon: const Icon(Icons.filter_list),
            tooltip: 'Filtra',
            onPressed: () => _showFilterSheet(context),
          ),
        ],
      ),
      body: RefreshIndicator(
        onRefresh: () async {
          HapticFeedback.lightImpact();
          ref.invalidate({{featureName}}Provider);
          await ref.read({{featureName}}Provider.future);
        },
        child: state.when(
          loading: () => const {{FeatureName}}Skeleton(),
          error: (error, _) => _ErrorView(
            message: error.toString(),
            onRetry: () => ref.invalidate({{featureName}}Provider),
          ),
          data: (items) => items.isEmpty
              ? const _EmptyView()
              : _DataView(items: items),
        ),
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => _navigateToCreate(context),
        tooltip: 'Aggiungi',
        child: const Icon(Icons.add),
      ),
    );
  }

  void _showFilterSheet(BuildContext context) {
    showModalBottomSheet(
      context: context,
      builder: (context) => const SizedBox(
        height: 300,
        child: Center(child: Text('Filtri')),
      ),
    );
  }

  void _navigateToCreate(BuildContext context) {
    // context.push('/{{feature_name}}/create');
  }
}

